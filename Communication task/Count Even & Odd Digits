#include <stdio.h>
int main() {
    int n, even = 0, odd = 0, r;

    printf("Enter number: ");
    scanf("%d", &n);

    for(; n != 0; n /= 10) {
        r = n % 10;

        if(r % 2 == 0)
            even++;
        else
            odd++;
    }

    printf("Even digits = %d\nOdd digits = %d", even, odd);

    return 0;
}
