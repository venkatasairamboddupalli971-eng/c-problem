
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();
            int S = sc.nextInt();

            int correct = (S + 3) / 4;
            int wrong = (4 * correct) - S;
            int attempts = correct + wrong;

            if (S > 4 * N || attempts > N) {
                System.out.println(-1);
            } else {
                System.out.println(attempts);
            }
        }

        sc.close();
    }
}
