#include <stdio.h>

int main() {
    int a[20], i, n, sum = 0, flag = 0;

    scanf("%d", &n);

    if (n > 20) {
        printf("Array size exceeds limit\n");
        return 0;
    }

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        sum += a[i];

        if (a[i] > n) {
            flag = 1;
        }
    }

    if (flag == 1) {
        printf("%d\n", sum);
    }

    return 0;
}
