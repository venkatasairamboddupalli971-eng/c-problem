#include <stdio.h>
int main() {
    int choice,num;

    printf("1.Square\n2.Cube\n3.Double\n");
    scanf("%d%d",&choice,&num);

    switch(choice) {
        case 1: printf("%d",num*num); break;
        case 2: printf("%d",num*num*num); break;
        case 3: printf("%d",num*2); break;
        default: printf("Invalid");
    }
}
