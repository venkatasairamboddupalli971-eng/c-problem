import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int steps = 0;

        while (num > 0) {
            switch (num % 2) {
                case 0:
                    num /= 2;
                    break;
                case 1:
                    num--;
                    break;
            }
            steps++;
        }

        System.out.println(steps);
    }
}
