import java.util.Scanner;

public class Main {

    static int solve(int num) {
        int count = 0;

        while (num != 0) {
            if (num % 2 == 0)
                num /= 2;
            else
                num--;

            count++;
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        System.out.println(solve(num));
    }
}
