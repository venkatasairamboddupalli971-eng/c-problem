import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int steps = 0;

        while (num != 0) {
            steps++;
            num = (num % 2 != 0) ? num - 1 : num / 2;
        }

        System.out.println(steps);
    }
}
