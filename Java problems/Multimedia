import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        int count = 0;

        while (n >= 10) {

            long product = 1;

            while (n > 0) {
                long digit = n % 10;
                product = product * digit;
                n = n / 10;
            }

            n = product;
            count++;
        }

        System.out.println(count + " " + n);
    }
}
