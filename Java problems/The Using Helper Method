import java.util.Scanner;

public class Main {

    static int steps(int n) {
        int count = 0;

        while (n > 0) {
            n = (n % 2 == 0) ? n / 2 : n - 1;
            count++;
        }

        return count;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println(steps(sc.nextInt()));
    }
}
