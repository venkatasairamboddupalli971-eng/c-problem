import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int s = sc.nextInt();
        int e = sc.nextInt();

        for(int n = s; n <= e; n++) {

            int sum = 0;

            for(int i = 1; i < n; i++) {

                if(n % i == 0) {
                    sum = sum + i;
                }
            }

            if(sum == n) {
                System.out.print(n + " ");
            }
        }
    }
}
