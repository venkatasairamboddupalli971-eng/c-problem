class Solution {

    public int digSum(int number) {
        int sum = 0;

        while (number > 0) {
            int digit = number % 10;
            sum += digit * digit;
            number /= 10;
        }

        return sum;
    }

    public boolean isHappy(int n) {

        while (n != 1 && n != 4) {
            n = digSum(n);
        }

        return n == 1;
    }
}
