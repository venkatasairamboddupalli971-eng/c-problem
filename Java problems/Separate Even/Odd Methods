import java.util.Scanner;

public class Main {

    static int even(int n) {
        return n / 2;
    }

    static int odd(int n) {
        return n - 1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int count = 0;

        while (num > 0) {
            if (num % 2 == 0)
                num = even(num);
            else
                num = odd(num);

            count++;
        }

        System.out.println(count);
    }
}
