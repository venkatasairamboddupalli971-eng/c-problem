import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int steps = 0;

        if (num == 0) {
            System.out.println(0);
            return;
        }

        do {
            if (num % 2 == 0)
                num /= 2;
            else
                num--;

            steps++;
        } while (num > 0);

        System.out.println(steps);
    }
}
