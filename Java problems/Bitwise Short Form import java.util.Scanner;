import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int steps = 0;

        while (num > 0) {
            num = ((num & 1) == 0) ? (num >> 1) : (num - 1);
            steps++;
        }

        System.out.println(steps);
    }
}
