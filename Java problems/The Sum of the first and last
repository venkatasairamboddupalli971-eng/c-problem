import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int sum = 0;
        int position = 1;

        while (n > 0) {
            int digit = n % 10;

            if (position % 2 == 1) {
                sum = sum + digit;
            } else {
                sum = sum - digit;
            }

            n = n / 10;
            position++;
        }

        System.out.println(sum);
    }
}
