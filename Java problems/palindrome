import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long num = sc.nextLong();
        long original = num;
        long reverse = 0;
        while (num > 0) {
            long digit = num % 10;
            reverse = reverse * 10 + digit;
            num = num / 10;
        }
        if (original == reverse) {
            System.out.println("Yes");
        } else {
            System.out.println("No");
        }
    }
}
