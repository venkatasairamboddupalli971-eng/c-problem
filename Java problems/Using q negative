import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int count = 0;

        while (num > 0) {
            if (num % 2 == 1) {
                num--;
                count++;
                continue;
            }

            num /= 2;
            count++;
        }

        System.out.println(count);
    }
}
