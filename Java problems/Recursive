import java.util.Scanner;

public class Main {

    static int count(int num) {
        return (num == 0) ? 0 : 1 + count((num % 2 == 0) ? num / 2 : num - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        System.out.println(count(num));
    }
}
