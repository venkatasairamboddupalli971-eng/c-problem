import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int count = 0;

        while (num != 0) {
            count++;

            if (num % 2 == 0)
                num /= 2;
            else
                num--;

        }

        System.out.println(count);
    }
}
