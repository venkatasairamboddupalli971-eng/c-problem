class Solution {
    public void rotate(int[] arr) {
        if (arr == null || arr.length <= 1) return;
        
        // Store the last element
        int lastElement = arr[arr.length - 1];
        
        // Shift elements to the right
        for (int i = arr.length - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }
        
        // Put the last element at the front
        arr[0] = lastElement;
    }
}
