import java.util.*;

public class Main {
    static long MOD = 998244353;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();
            int[] c = new int[N + 1];

            for (int i = 0; i < N; i++)
                c[sc.nextInt()]++;

            long[] p = new long[N + 1];
            p[0] = 1;

            for (int i = 1; i <= N; i++)
                p[i] = p[i - 1] * 2 % MOD;

            long ans = 0, pref = 1;

            for (int m = 0; m <= N; m++) {
                long ways = (p[c[m]] - 1 + MOD) % MOD;

                if (ways > 0) {
                    pref = pref * ways % MOD;
                    ans = (ans + pref) % MOD;
                } else {
                    pref = 0;
                }

                if (m > 0 && c[m - 1] == 0) {
                    long before = (m == 1) ? 1 : 
                                  (c[m - 2] > 0 ? pref * 1 % MOD : 0);
                }
            }

            System.out.println(ans);
        }
    }
}
