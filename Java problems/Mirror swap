import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();

            long[] A = new long[2 * N];

            for (int i = 0; i < 2 * N; i++) {
                A[i] = sc.nextLong();
            }

            long sum = 0;

            for (int i = 0; i < N; i++) {
                sum += Math.max(A[i], A[2 * N - 1 - i]);
            }

            System.out.println(sum);
        }
    }
}
