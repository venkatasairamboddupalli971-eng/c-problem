import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int temp = num;
        int steps = 0;

        while (temp != 0) {
            if (temp % 2 == 0)
                temp = temp / 2;
            else
                temp = temp - 1;

            steps++;
        }

        System.out.println(steps);
    }
}
