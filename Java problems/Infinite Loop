import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int count = 0;

        for (;;) {
            if (num == 0)
                break;

            num = (num % 2 == 0) ? num / 2 : num - 1;
            count++;
        }

        System.out.println(count);
    }
}
