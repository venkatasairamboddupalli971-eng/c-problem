import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num = sc.nextInt();
        int count = 0;
        boolean running = true;

        while (running) {
            if (num == 0) {
                running = false;
            } else {
                if (num % 2 == 0)
                    num /= 2;
                else
                    num--;

                count++;
            }
        }

        System.out.println(count);
    }
}
