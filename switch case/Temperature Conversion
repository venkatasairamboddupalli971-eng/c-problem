#include <stdio.h>
int main() {
    int choice;
    float c,f;

    scanf("%d",&choice);

    switch(choice) {
        case 1:
            scanf("%f",&c);
            f = (c * 9/5) + 32;
            printf("%.2f",f);
            break;

        case 2:
            scanf("%f",&f);
            c = (f - 32) * 5/9;
            printf("%.2f",c);
            break;

        default:
            printf("Invalid");
    }
}
