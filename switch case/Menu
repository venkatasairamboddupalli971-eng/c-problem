#include <stdio.h>

int main()
{
    int choice, qty;
    int total = 0, price;

    while(1)
    {
        printf("\n--- Restaurant Menu ---\n");
        printf("1. Burger - 120\n");
        printf("2. Pizza - 250\n");
        printf("3. Sandwich - 100\n");
        printf("4. Coffee - 80\n");
        printf("5. Tea - 40\n");
        printf("0. Exit & Generate Bill\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        if(choice == 0)
            break;

        printf("Enter quantity: ");
        scanf("%d", &qty);

        switch(choice)
        {
            case 1:
                price = 120;
                total += price * qty;
                break;

            case 2:
                price = 250;
                total += price * qty;
                break;

            case 3:
                price = 100;
                total += price * qty;
                break;

            case 4:
                price = 80;
                total += price * qty;
                break;

            case 5:
                price = 40;
                total += price * qty;
                break;

            default:
                printf("Invalid choice!\n");
        }
    }

    printf("\nTotal Bill = %d\n", total);

    // Discount
    if(total > 1000)
    {
        float discount = total * 0.10;
        float finalBill = total - discount;

        printf("Discount (10%%) = %.2f\n", discount);
        printf("Final Bill = %.2f\n", finalBill);
    }
    else
    {
        printf("No discount applied.\n");
    }

    printf("Thank you! Visit again.\n");

    return 0;
}
