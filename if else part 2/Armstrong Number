#include<stdio.h>
#include<math.h>

int main() {
    int n, original, remainder, result = 0, count = 0;
    int temp;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;
    temp = n;

    // Count digits
    for(; temp != 0; temp /= 10)
        count++;

    // Calculate Armstrong sum
    for(; n != 0; n /= 10) {
        remainder = n % 10;
        result += pow(remainder, count);
    }

    if(result == original)
        printf("Armstrong Number");
    else
        printf("Not Armstrong Number");

    return 0;
}
