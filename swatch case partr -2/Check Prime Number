#include <stdio.h>
int main() {
    int num,i,flag=1;
    scanf("%d",&num);

    switch(num<=1) {
        case 1: printf("Not Prime"); break;
        case 0:
            for(i=2;i<=num/2;i++) {
                if(num%i==0) {
                    flag=0;
                    break;
                }
            }

            switch(flag) {
                case 1: printf("Prime"); break;
                case 0: printf("Not Prime");
            }
    }
}
