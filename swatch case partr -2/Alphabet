#include <stdio.h>
int main() {
    char ch;
    scanf("%c",&ch);

    switch((ch>='0' && ch<='9')) {
        case 1: printf("Digit"); break;
        case 0:
            switch((ch>='A'&&ch<='Z')||(ch>='a'&&ch<='z')) {
                case 1: printf("Alphabet"); break;
                default: printf("Special Character");
            }
    }
}
