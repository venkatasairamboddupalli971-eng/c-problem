#include <stdio.h>
int main() {
    char ch;
    scanf("%c",&ch);

    switch(ch >= 'A' && ch <= 'Z') {
        case 1: printf("Uppercase"); break;
        case 0:
            switch(ch >= 'a' && ch <= 'z') {
                case 1: printf("Lowercase"); break;
                default: printf("Not Alphabet");
            }
    }
}
