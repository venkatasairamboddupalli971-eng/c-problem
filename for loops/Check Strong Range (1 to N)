#include <stdio.h>
int main() {
    int i, j, n, temp, r, fact, sum;

    printf("Enter limit: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++) {
        temp = i;
        sum = 0;

        for(; temp != 0; temp /= 10) {
            r = temp % 10;
            fact = 1;

            for(j = 1; j <= r; j++)
                fact *= j;

            sum += fact;
        }

        if(sum == i)
            printf("%d ", i);
    }

    return 0;
}
