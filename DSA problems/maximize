import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();

            long[] A = new long[N];

            for (int i = 0; i < N; i++) {
                A[i] = sc.nextLong();
            }

            Arrays.sort(A);

            long total = 0;
            for (long x : A) {
                total += x;
            }

            long redSum = 0;
            long answer = 0;

            // Red = largest k elements
            for (int k = 1; k < N; k++) {
                redSum += A[N - k];

                long blueSum = total - redSum;

                long CR = k;
                long CB = N - k;

                long value = redSum * CB + blueSum * CR;

                answer = Math.max(answer, value);
            }

            System.out.println(answer);
        }
    }
}
