import java.util.*;

class Solution {
    public String rearrangeString(String s, int k) {

        if (k <= 1) {
            return s;
        }

        Map<Character, Integer> map = new HashMap<>();

        // Count frequency
        for (char ch : s.toCharArray()) {
            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }

        // Max Heap based on frequency
        PriorityQueue<int[]> pq = new PriorityQueue<>(
            (a, b) -> b[1] - a[1]
        );

        for (char ch : map.keySet()) {
            pq.offer(new int[]{ch, map.get(ch)});
        }

        StringBuilder result = new StringBuilder();

        // Queue stores: character and remaining frequency
        Queue<int[]> waitQueue = new LinkedList<>();

        while (!pq.isEmpty()) {

            int[] current = pq.poll();

            char ch = (char) current[0];
            result.append(ch);

            current[1]--;

            // Add to waiting queue
            waitQueue.offer(current);

            // After k positions, character can be used again
            if (waitQueue.size() >= k) {
                int[] item = waitQueue.poll();

                if (item[1] > 0) {
                    pq.offer(item);
                }
            }
        }

        return result.length() == s.length() ? result.toString() : "";
    }
}
