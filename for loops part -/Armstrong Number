#include <stdio.h>
int main() {
    int n, temp, sum = 0, r;
    printf("Enter number: ");
    scanf("%d", &n);

    temp = n;

    for(; n != 0; n /= 10) {
        r = n % 10;
        sum += r * r * r;
    }

    if(sum == temp)
        printf("Armstrong");
    else
        printf("Not Armstrong");

    return 0;
}
