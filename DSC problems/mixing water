import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();
            int K = sc.nextInt();

            int[] A = new int[N];

            for (int i = 0; i < N; i++) {
                A[i] = sc.nextInt();
            }

            Arrays.sort(A);

            int sum = A[N - 1];

            for (int i = 1; i <= K && i < N; i++) {
                sum += A[N - 1 - i];
            }

            System.out.println(sum);
        }

        sc.close();
    }
}
