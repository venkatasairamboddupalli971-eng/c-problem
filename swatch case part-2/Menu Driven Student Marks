#include <stdio.h>
int main() {
    int choice,marks;
    scanf("%d",&choice);

    switch(choice) {
        case 1:
            scanf("%d",&marks);
            printf("Marks = %d",marks);
            break;
        case 2:
            scanf("%d",&marks);
            printf("Square = %d",marks*marks);
            break;
        default:
            printf("Invalid");
    }
}
