#include <stdio.h>
int main() {
    char ch = '5';

    switch(ch >= '0' && ch <= '9') {
        case 1: printf("Digit"); break;
        case 0:
            switch((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
                case 1: printf("Letter"); break;
                case 0: printf("Symbol");
            }
    }
}
